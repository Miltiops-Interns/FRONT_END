# MongoDB Atlas Connection String
# Replace <db_username> and <db_password> with your MongoDB Atlas credentials
MONGO_URI=mongodb+srv://<db_username>:<db_password>@cluster0.coynk5o.mongodb.net/restaurant-app?retryWrites=true&w=majority&appName=Cluster0

# JWT Secret Key (generate a strong random string)
JWT_SECRET=your_super_secret_jwt_key_here_change_this_in_production

# Server Port (Render will automatically set this)
PORT=5000

# Email Configuration (for sending notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-specific-password

# Admin Email (to receive notifications)
ADMIN_EMAIL=admin@yourdomain.com

# Node Environment
NODE_ENV=production

# Frontend URL (for CORS - will be your Render frontend URL)
FRONTEND_URL=http://localhost:3000

